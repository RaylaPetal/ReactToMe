<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.3</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Rayla Petal</Author>
    <Name>ReactToMe</Name>
    <Punchline>Reacts to emotes performed on you with a temporary Glamourer design and Moodle.</Punchline>
    <Description>Listens for emotes targeted at you and applies a configured Glamourer design and Moodles status in response, automatically reverting the Glamourer design after a set duration.</Description>
    <RepoUrl>https://github.com/RaylaPetal/ReactToMe</RepoUrl>
    <Tags>emote;glamourer;moodles;automation</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
    <PackageReference Include="ECommons" Version="3.2.1.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Built from source against the Penumbra.Api and Luna submodules (matching how Glamourer and
      Penumbra.Api's other consumers build) rather than the published NuGet package - as of
      Penumbra.Api 5.19.0, that package's compiled DLL references an assembly literally named "Luna",
      but the separately-published "Luna" NuGet package's DLL identifies itself as "Luna.Core" (a
      genuine assembly-name mismatch in the published packages, confirmed via disassembling both
      DLLs' assembly references, same finding as xiv-collar's and PoseKit's) - no reference short of
      building from source resolves it.
    -->
    <ProjectReference Include="..\Penumbra.Api\Penumbra.Api.csproj" />
    <ProjectReference Include="..\Luna\Luna\Luna.csproj" />
    <ProjectReference Include="..\Luna\Luna.Generators\Luna.Generators.csproj" OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
